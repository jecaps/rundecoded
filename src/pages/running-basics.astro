---
import { RoutePlaceholder } from '@components/RoutePlaceholder';
import AppLayout from '@layouts/AppLayout.astro';

const description =
  'The future reference guide for running concepts, terminology, and product education.';
---

<AppLayout title="Running Basics" description={description}>
  <RoutePlaceholder
    eyebrow="Reference guide"
    title="Running Basics"
    description={description}
    note="The shared navigation and display preferences are ready. Structured educational topics arrive in the Running Basics migration phase."
  />
</AppLayout>
