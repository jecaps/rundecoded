---
import AppLayout from '@layouts/AppLayout.astro';
import PhonePageHeader from '@/components/PhonePageHeader.astro';
import { PhoneSettings } from '@/features/settings/PhoneSettings';
import { getLocaleStaticPaths, type Locale } from '@/i18n/config';

export const getStaticPaths = getLocaleStaticPaths;

const locale = Astro.params.lang as Locale;
const title = { en: 'Settings', de: 'Einstellungen', fr: 'Réglages' }[locale];
---

<AppLayout
  title={title}
  description={title}
  locale={locale}
  route="settings"
  phoneSecondaryPage
>
  <PhonePageHeader kind="settings" locale={locale} />
  <PhoneSettings client:load locale={locale} />
</AppLayout>
