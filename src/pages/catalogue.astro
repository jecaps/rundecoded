---
import { RoutePlaceholder } from '@components/RoutePlaceholder';
import AppLayout from '@layouts/AppLayout.astro';

const description =
  'The future home of the structured RunDecoded running-product catalogue.';
---

<AppLayout title="Catalogue" description={description}>
  <RoutePlaceholder
    eyebrow="Product explorer"
    title="Catalogue"
    description={description}
    note="The shared RunDecoded shell is ready. Product cards, search, filters, and comparison arrive with the first end-to-end explorer slice."
  />
</AppLayout>
