---
import AppBanner from '@/components/app/AppBanner.astro';
import SiteFooter from '@/components/app/SiteFooter.astro';

import '../styles/global.css';

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const requestedLocale = Astro.url.searchParams.get('lang');
const locale =
  requestedLocale === 'de' || requestedLocale === 'fr' ? requestedLocale : 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏃</text></svg>"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | RunDecoded</title>
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('rundecoded-theme');
        const theme =
          storedTheme === 'dark' || storedTheme === 'light'
            ? storedTheme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;

        const params = new URLSearchParams(location.search);
        const requestedLocale = params.get('lang');
        const storedLocale = localStorage.getItem('rundecoded-locale');
        const locale = ['de', 'en', 'fr'].includes(requestedLocale)
          ? requestedLocale
          : ['de', 'en', 'fr'].includes(storedLocale)
            ? storedLocale
            : 'en';
        document.documentElement.lang = locale;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-frame">
      <AppBanner currentPath={Astro.url.pathname} locale={locale} />
      <main id="main-content" class="page-container" tabindex="-1">
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>

<style>
  .app-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }
</style>
