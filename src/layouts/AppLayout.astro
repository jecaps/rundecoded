---
import AppBanner from '@/components/app/AppBanner.astro';
import SiteFooter from '@/components/app/SiteFooter.astro';
import { DisplayControls } from '@/components/DisplayControls';
import type { Locale } from '@/i18n/config';
import { sharedMessages } from '@/i18n/messages';
import { localizedRoute, type LocalizedRouteKey } from '@/lib/routes';
import { ClientRouter } from 'astro:transitions';

import '../styles/global.css';

interface Props {
  compactBanner?: boolean;
  description: string;
  hideBanner?: boolean;
  phoneSecondaryPage?: boolean;
  pagePath?: (locale: Locale) => string;
  locale: Locale;
  route: LocalizedRouteKey;
  title: string;
}

const {
  compactBanner = false,
  description,
  hideBanner = false,
  phoneSecondaryPage = false,
  pagePath,
  locale,
  route,
  title,
} = Astro.props as Props;
const messages = sharedMessages[locale];
const siteOrigin = Astro.site ?? Astro.url.origin;
const routePath =
  pagePath ??
  ((alternateLocale: Locale) => localizedRoute(alternateLocale, route));
const canonicalUrl = new URL(routePath(locale), siteOrigin);
const alternates = (['en', 'de', 'fr'] as const).map((alternateLocale) => ({
  href: new URL(routePath(alternateLocale), siteOrigin),
  locale: alternateLocale,
}));
---

<!doctype html>
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={alternate.href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(routePath('en'), siteOrigin)}
    />
    <meta property="og:title" content={`${title} | RunDecoded`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏃</text></svg>"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | RunDecoded</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const systemTheme = matchMedia('(prefers-color-scheme: dark)');
        const applyTheme = (root = document.documentElement) => {
          const storedTheme = localStorage.getItem('rundecoded-theme');
          root.dataset.theme =
            storedTheme === 'dark' || storedTheme === 'light'
              ? storedTheme
              : systemTheme.matches
                ? 'dark'
                : 'light';
        };
        applyTheme();

        const pathLocale = location.pathname.match(/\/(de|en|fr)(?:\/|$)/)?.[1];
        document.documentElement.lang = pathLocale ?? 'en';

        if (!window.__rundecodedThemeWatcher) {
          window.__rundecodedThemeWatcher = true;
          systemTheme.addEventListener('change', () => applyTheme());
          document.addEventListener('astro:before-swap', (event) => {
            applyTheme(event.newDocument.documentElement);
          });
          document.addEventListener('astro:after-swap', () => {
            applyTheme();
            const nextLocale =
              location.pathname.match(/\/(de|en|fr)(?:\/|$)/)?.[1];
            document.documentElement.lang = nextLocale ?? 'en';
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{messages.skipLink}</a>
    <div class:list={['app-frame', { 'app-frame--banner-hidden': hideBanner }]}>
      <AppBanner
        compact={compactBanner}
        currentPath={Astro.url.pathname}
        hideOnPhone={phoneSecondaryPage}
        locale={locale}
      />
      <div
        class:list={[
          'tablet-app-header',
          { 'max-[35.99rem]:hidden!': phoneSecondaryPage },
        ]}
      >
        <a
          aria-label={messages.banner.catalogueLabel}
          class="tablet-app-header__brand"
          href={localizedRoute(locale, 'catalogue')}
        >
          <span>RUN</span><span>DECODED</span>
        </a>
        <DisplayControls client:only="react" compact initialLocale={locale} />
      </div>
      <main
        id="main-content"
        class:list={[
          'page-container',
          phoneSecondaryPage
            ? 'max-[35.99rem]:mx-0! max-[35.99rem]:w-full! max-[35.99rem]:pb-0!'
            : 'max-[35.99rem]:pb-[calc(4.25rem+env(safe-area-inset-bottom))]',
        ]}
        tabindex="-1"
      >
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>

<style>
  .app-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }

  .tablet-app-header {
    display: none;
  }

  .app-frame--banner-hidden > :global(.app-banner) {
    display: none;
  }

  @media (max-width: 64rem) {
    .app-frame > :global(.site-footer) {
      display: none;
    }
  }

  @media (max-width: 35.99rem) {
    .app-frame--banner-hidden > :global(.app-banner) {
      display: block;
    }

    .tablet-app-header {
      position: sticky;
      top: 0;
      z-index: 30;
      display: flex;
      min-height: calc(3.75rem + env(safe-area-inset-top));
      align-items: center;
      justify-content: space-between;
      padding: env(safe-area-inset-top) var(--page-gutter) 0;
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }

    .tablet-app-header__brand {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      color: var(--foreground);
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1;
      text-decoration: none;
    }

    .tablet-app-header__brand span:last-child {
      color: var(--primary);
    }
  }

  @media (min-width: 36rem) and (max-width: 64rem) {
    .app-frame {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-rows: 4.5rem minmax(0, 1fr);
      align-items: stretch;
    }

    .app-frame > :global(.app-banner) {
      grid-column: 1;
      grid-row: 1 / -1;
    }

    .app-frame--banner-hidden > :global(.app-banner) {
      display: flex;
    }

    .tablet-app-header {
      display: flex;
      grid-column: 2;
      grid-row: 1;
      align-items: center;
      justify-content: space-between;
      padding-inline: var(--page-gutter);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }

    .tablet-app-header__brand {
      display: inline-flex;
      color: var(--foreground);
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1;
      text-decoration: none;
    }

    .tablet-app-header__brand span:last-child {
      color: var(--primary);
    }

    .app-frame > main.page-container {
      grid-column: 2;
      grid-row: 2;
      width: auto;
      min-width: 0;
      margin-inline: 0;
      padding-inline: clamp(0.75rem, 2vw, 1.25rem);
    }
  }
</style>
