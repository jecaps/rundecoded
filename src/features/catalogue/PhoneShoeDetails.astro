---
import { ArrowUpRight, Check, Plus } from 'lucide-react';
import {
  resolveLocalizedText,
  surfaceFamiliesForShoe,
  terrainProfilesForShoe,
  type SupportedLocale,
} from '@/domain/catalogue';
import { localizedShoeRoute } from '@/lib/routes';
import type { ExplorerProduct } from './catalogue';
import {
  catalogueCopy,
  categoryLabel,
  stabilityLabel,
  surfaceFamilyLabel,
  terrainProfileLabel,
} from './copy';

interface Props {
  assetBase: string;
  item: ExplorerProduct;
  locale: SupportedLocale;
  similar: ExplorerProduct[];
}

const { assetBase, item, locale, similar } = Astro.props;
const copy = catalogueCopy[locale];
const { product } = item;
const image = product.images[0];
const bestForItems = resolveLocalizedText(product.details.bestFor, locale)
  .value.split('·')
  .map((part) => part.trim())
  .filter(Boolean);
const distance = product.specifications.maximumDistanceKm;
const drop = product.specifications.dropMm;
const primaryCategory = product.categories[0];
const primaryTerrain = terrainProfilesForShoe(product)[0];
const secondaryBadge = primaryTerrain
  ? terrainProfileLabel(primaryTerrain, locale)
  : stabilityLabel(product.stability, locale);
const stack = product.specifications.stackHeightMm;
const stackHeight =
  stack === null
    ? '—'
    : typeof stack === 'number'
      ? `${stack} mm`
      : `${stack.heel} / ${stack.forefoot} mm`;
const construction = product.details.construction;
const constructionFields = construction
  ? ([
      [copy.rideCharacter, construction.ride],
      [copy.support, construction.support],
      [copy.upper, construction.upper],
      [copy.midsole, construction.midsole],
      [copy.outsole, construction.outsole],
    ] as const)
  : [];
const selectionLimit = {
  en: 'Remove one shoe before adding another.',
  de: 'Entferne zuerst einen Schuh, bevor du einen weiteren hinzufügst.',
  fr: 'Retirez d’abord une chaussure avant d’en ajouter une autre.',
}[locale];
---

<article
  class="bg-surface tablet:mx-auto tablet:my-5 tablet:max-w-4xl tablet:overflow-hidden tablet:rounded-[var(--radius-panel)] tablet:border tablet:border-border"
>
  <div
    class="bg-surface-subtle tablet:aspect-[2.5/1] flex aspect-[3/2] w-full items-center justify-center overflow-hidden"
  >
    {
      image ? (
        <img
          alt={copy.productImage(product.model)}
          class="h-full w-full object-contain"
          src={`${assetBase}${image}`}
        />
      ) : (
        <span class="text-muted-foreground">{copy.imagePending}</span>
      )
    }
  </div>
  <div class="tablet:px-8 px-5 py-6">
    <p class="text-muted-foreground m-0 text-sm font-semibold">
      {product.brand}
    </p>
    <h1 class="mt-1 mb-3 text-3xl leading-tight font-bold">{product.model}</h1>
    <div class="flex flex-wrap gap-2">
      {
        primaryCategory ? (
          <span class="bg-surface-subtle rounded-[var(--radius-sm)] px-2.5 py-1 text-xs font-semibold">
            {categoryLabel(primaryCategory, primaryCategory, locale)}
          </span>
        ) : null
      }
      <span
        class="border-border rounded-[var(--radius-sm)] border px-2.5 py-1 text-xs font-semibold"
        >{secondaryBadge}</span
      >
    </div>

    <section class="mt-7">
      <h2
        class="text-primary m-0 text-sm font-bold tracking-[0.14em] uppercase"
      >
        {copy.bestFor}
      </h2>
      <ul class="marker:text-primary mt-3 grid gap-2 pl-5 text-base leading-6">
        {bestForItems.map((part) => <li>{part}</li>)}
      </ul>
    </section>

    <dl class="mt-7 grid grid-cols-2 gap-3">
      <div class="border-border rounded-[var(--radius-control)] border p-4">
        <dt class="text-muted-foreground text-xs font-bold uppercase">
          {copy.distance}
        </dt>
        <dd class="text-primary mt-2 text-3xl font-bold">
          {distance === null ? '—' : distance}
          <span class="text-base font-medium"
            >{distance === null ? '' : 'km'}</span
          >
        </dd>
      </div>
      <div class="border-border rounded-[var(--radius-control)] border p-4">
        <dt class="text-muted-foreground text-xs font-bold uppercase">
          {copy.drop}
        </dt>
        <dd class="text-primary mt-2 text-3xl font-bold">
          {drop === null ? '—' : drop}
          <span class="text-base font-medium">{drop === null ? '' : 'mm'}</span>
        </dd>
      </div>
    </dl>

    <dl class="border-border mt-7 grid grid-cols-2 gap-4 border-t pt-5 text-sm">
      <div>
        <dt class="text-muted-foreground font-bold uppercase">
          {copy.surface}
        </dt><dd class="mt-1">
          {
            surfaceFamiliesForShoe(product)
              .map((value) => surfaceFamilyLabel(value, locale))
              .join(', ') || copy.notApplicable
          }
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground font-bold uppercase">
          {copy.terrain}
        </dt><dd class="mt-1">
          {
            terrainProfilesForShoe(product)
              .map((value) => terrainProfileLabel(value, locale))
              .join(', ') || copy.notApplicable
          }
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground font-bold uppercase">
          {copy.stability}
        </dt><dd class="mt-1">{stabilityLabel(product.stability, locale)}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground font-bold uppercase">
          {copy.weightValue}
        </dt><dd class="mt-1">
          {
            item.weight
              ? `${item.weight.amount} ${item.weight.unit}`
              : copy.pending
          }
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground font-bold uppercase">{copy.fit}</dt><dd
          class="mt-1"
        >
          {product.specifications.fit.join(', ') || copy.pending}
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground font-bold uppercase">
          {copy.stackHeight}
        </dt><dd class="mt-1">{stackHeight}</dd>
      </div>
    </dl>

    <section class="border-border mt-7 border-t pt-5">
      <h2 class="m-0 text-lg font-semibold">{copy.productOverview}</h2>
      <p class="text-muted-foreground mt-2 mb-0 text-sm leading-6">
        {resolveLocalizedText(product.details.overview, locale).value}
      </p>
    </section>

    <section class="border-border mt-7 border-t pt-5">
      <h2 class="m-0 text-lg font-semibold">
        {construction ? copy.constructionAndRide : copy.technologies}
      </h2>
      {
        construction ? (
          <dl class="mt-3 grid gap-3 text-sm">
            {constructionFields.map(([label, value]) => (
              <div>
                <dt class="text-muted-foreground font-bold uppercase">
                  {label}
                </dt>
                <dd class="mt-1 leading-6">
                  {resolveLocalizedText(value, locale).value}
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="text-muted-foreground mt-2 mb-0 text-sm leading-6">
            {product.specifications.technologies.join(' · ') ||
              copy.detailsPending}
          </p>
        )
      }
    </section>

    <section class="border-border mt-7 border-t pt-5">
      <h2 class="m-0 text-lg font-semibold">{copy.strengthsAndLimitations}</h2>
      <dl class="mt-3 grid gap-3 text-sm">
        <div>
          <dt class="text-muted-foreground font-bold uppercase">
            {copy.bestAt}
          </dt><dd class="mt-1 leading-6">
            {resolveLocalizedText(product.details.bestAt, locale).value}
          </dd>
        </div>
        <div>
          <dt class="text-muted-foreground font-bold uppercase">
            {copy.lessSuitableFor}
          </dt><dd class="mt-1 leading-6">
            {
              resolveLocalizedText(product.details.lessSuitableFor, locale)
                .value
            }
          </dd>
        </div>
      </dl>
    </section>

    <section class="border-border mt-7 border-t pt-5">
      <h2
        class="text-primary m-0 text-sm font-bold tracking-[0.14em] uppercase"
      >
        {copy.comparableProducts}
      </h2>
      <div class="mt-3 flex snap-x gap-3 overflow-x-auto pb-2">
        {
          similar.map(({ product: candidate }) => (
            <a
              class="border-border bg-surface-subtle block max-w-44 min-w-36 flex-1 snap-start overflow-hidden rounded-[var(--radius-control)] border no-underline"
              data-similar-shoe-id={candidate.id}
              href={localizedShoeRoute(locale, candidate.id)}
            >
              <span class="block aspect-[4/3] bg-white">
                {candidate.images[0] ? (
                  <img
                    alt=""
                    class="h-full w-full object-contain"
                    loading="lazy"
                    src={`${assetBase}${candidate.images[0]}`}
                  />
                ) : null}
              </span>
              <span class="block px-3 py-2 text-sm font-semibold">
                {candidate.model}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-6 grid gap-2">
      <button
        aria-label={copy.compare}
        aria-pressed="false"
        class="bg-primary text-primary-foreground invisible flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-[var(--radius-control)] px-4 font-semibold"
        data-compare-add={copy.compare}
        data-compare-added={copy.added}
        data-compare-id={product.id}
        data-selection-limit={selectionLimit}
        type="button"
      >
        <Plus aria-hidden="true" className="size-4" data-compare-plus />
        <Check
          aria-hidden="true"
          className="hidden size-4"
          data-compare-check
        />
        <span data-compare-label>{copy.compare}</span>
      </button>
      <p class="text-danger m-0 hidden text-sm" data-compare-error role="alert">
      </p>
      {
        product.sourceUrl ? (
          <a
            class="border-border flex min-h-11 items-center justify-center gap-2 rounded-[var(--radius-control)] border px-4 font-semibold no-underline"
            href={product.sourceUrl}
            rel="noreferrer"
            target="_blank"
          >
            {copy.sourceProduct}
            <ArrowUpRight aria-hidden="true" className="size-4" />
          </a>
        ) : null
      }
    </div>
  </div>
</article>

<script>
  const selectionKey = 'rundecoded:catalogue-comparison-selection';

  function readSelection(): string[] {
    try {
      const stored: unknown = JSON.parse(
        window.sessionStorage.getItem(selectionKey) ?? '[]',
      );
      return Array.isArray(stored)
        ? stored
            .filter((id): id is string => typeof id === 'string')
            .slice(0, 2)
        : [];
    } catch {
      return [];
    }
  }

  function setupCompareButton() {
    const button =
      document.querySelector<HTMLButtonElement>('[data-compare-id]');
    if (!button) return;
    if (button.dataset.compareBound === 'true') return;
    button.dataset.compareBound = 'true';
    const label = button.querySelector<HTMLElement>('[data-compare-label]');
    const plus = button.querySelector<HTMLElement>('[data-compare-plus]');
    const check = button.querySelector<HTMLElement>('[data-compare-check]');
    const error = document.querySelector<HTMLElement>('[data-compare-error]');
    const id = button.dataset.compareId;
    if (!id) return;

    function update() {
      if (!button || !id) return;
      const selected = readSelection().includes(id);
      button.setAttribute('aria-pressed', String(selected));
      button.setAttribute(
        'aria-label',
        selected
          ? (button.dataset.compareAdded ?? '')
          : (button.dataset.compareAdd ?? ''),
      );
      if (label)
        label.textContent = selected
          ? (button.dataset.compareAdded ?? '')
          : (button.dataset.compareAdd ?? '');
      plus?.classList.toggle('hidden', selected);
      check?.classList.toggle('hidden', !selected);
      button.classList.remove('invisible');
    }

    update();
    button.addEventListener('click', () => {
      if (error) error.classList.add('hidden');
      const current = readSelection();
      const next = current.includes(id)
        ? current.filter((selectedId) => selectedId !== id)
        : current.length < 2
          ? [...current, id]
          : null;
      if (!next) {
        if (error) {
          error.textContent = button.dataset.selectionLimit ?? '';
          error.classList.remove('hidden');
        }
        return;
      }
      if (next.length)
        window.sessionStorage.setItem(selectionKey, JSON.stringify(next));
      else window.sessionStorage.removeItem(selectionKey);
      window.dispatchEvent(
        new CustomEvent('rundecoded:comparison-selection-change', {
          detail: { count: next.length },
        }),
      );
      update();
    });
  }

  function setupSimilarLinks() {
    const currentId =
      document.querySelector<HTMLElement>('[data-compare-id]')?.dataset
        .compareId;
    document
      .querySelectorAll<HTMLAnchorElement>('[data-similar-shoe-id]')
      .forEach((link) => {
        if (link.dataset.returnBound === 'true') return;
        link.dataset.returnBound = 'true';
        link.addEventListener('click', () => {
          try {
            const context = JSON.parse(
              window.sessionStorage.getItem('rundecoded:phone-shoe-return') ??
                'null',
            ) as { shoeId?: string } | null;
            if (!context || context.shoeId !== currentId) return;
            context.shoeId = link.dataset.similarShoeId;
            window.sessionStorage.setItem(
              'rundecoded:phone-shoe-return',
              JSON.stringify(context),
            );
          } catch {
            // A direct shoe link works without stored navigation context.
          }
        });
      });
  }

  setupCompareButton();
  setupSimilarLinks();
  document.addEventListener('astro:page-load', () => {
    setupCompareButton();
    setupSimilarLinks();
  });
</script>
