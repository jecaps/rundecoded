---
import { ProductExplorer } from '@/features/catalogue/ProductExplorer';
import { getProductCatalogue } from '@/features/catalogue/catalogue';
import type { Locale } from '@/i18n/config';
import { sharedMessages } from '@/i18n/messages';
import AppLayout from '@layouts/AppLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const metadata = sharedMessages[locale].pages.compare;
const products = getProductCatalogue();
---

<AppLayout
  title={metadata.title}
  description={metadata.description}
  locale={locale}
  route="compare"
>
  <ProductExplorer
    assetBase={import.meta.env.BASE_URL}
    initialLocale={locale}
    products={products}
    view="comparison"
    client:load
  />
</AppLayout>
