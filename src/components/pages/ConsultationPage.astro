---
import AppLayout from '@layouts/AppLayout.astro';

import { getProductCatalogue } from '@/features/catalogue/catalogue';
import { CustomerConsultation } from '@/features/consultation/CustomerConsultation';
import type { Locale } from '@/i18n/config';
import { sharedMessages } from '@/i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const metadata = sharedMessages[locale].pages.consultation;
const products = getProductCatalogue().map(({ product }) => product);
---

<AppLayout
  compactBanner
  title={metadata.title}
  description={metadata.description}
  locale={locale}
  route="consultation"
>
  <CustomerConsultation
    assetBase={import.meta.env.BASE_URL}
    locale={locale}
    products={products}
    client:load
  />
</AppLayout>
