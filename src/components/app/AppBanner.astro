---
import { isCurrentRoute, routes } from '@/lib/routes';

interface Props {
  currentPath: string;
  locale: string;
}

const { currentPath, locale } = Astro.props;
const withLocale = (href: string) => `${href}?lang=${locale}`;
const navigation = [
  { href: routes.catalogue, label: 'Catalogue' },
  { href: routes.runningBasics, label: 'Running Basics' },
];
---

<header class="app-banner page-container">
  <div class="app-banner__hero">
    <a
      class="app-banner__brand"
      data-locale-aware
      href={withLocale(routes.catalogue)}
      aria-label="RunDecoded catalogue"
    >
      <span class="app-banner__eyebrow"
        >Running product training · By Jerika</span
      >
      <span class="app-banner__title">RunDecoded</span>
    </a>
    <p class="app-banner__description">
      Understand what running products are designed to do—from cushioning and
      stability to surface and intended use.
    </p>
    <span class="app-banner__watermark" aria-hidden="true">RUN</span>
  </div>

  <nav class="primary-tabs" aria-label="Primary navigation">
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              aria-current={
                isCurrentRoute(currentPath, item.href) ? 'page' : undefined
              }
              data-locale-aware
              href={withLocale(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .app-banner {
    margin-top: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--shell-navigation-border);
    border-radius: var(--radius-shell);
    background: var(--shell-navigation);
    box-shadow: var(--shadow-panel);
  }

  .app-banner__hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(15rem, 30vw, 21rem);
    overflow: hidden;
    background: linear-gradient(
      120deg,
      var(--banner-start),
      var(--banner-middle) 58%,
      var(--banner-end)
    );
    color: var(--banner-foreground);
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .app-banner__hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 82% 10%,
        rgb(255 255 255 / 12%),
        transparent 28%
      ),
      linear-gradient(90deg, rgb(255 255 255 / 4%), transparent 45%);
    content: '';
  }

  .app-banner__brand {
    display: inline-flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .app-banner__eyebrow {
    color: var(--banner-muted);
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    font-weight: 750;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .app-banner__title {
    margin-top: clamp(1.2rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 780;
    letter-spacing: -0.075em;
    line-height: 0.86;
  }

  .app-banner__description {
    position: relative;
    z-index: 1;
    max-width: 49rem;
    margin: clamp(1.3rem, 3vw, 2rem) 0 0;
    color: var(--banner-foreground);
    font-size: clamp(1rem, 2.1vw, 1.35rem);
    line-height: 1.55;
  }

  .app-banner__watermark {
    position: absolute;
    right: -0.02em;
    bottom: -0.28em;
    z-index: 0;
    color: rgb(255 255 255 / 10%);
    font-size: clamp(9rem, 25vw, 20rem);
    font-weight: 850;
    letter-spacing: -0.1em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .primary-tabs {
    min-height: 4.5rem;
    padding-inline: clamp(1rem, 3vw, 2.25rem);
  }

  .primary-tabs ul {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 4vw, 2.5rem);
    height: 100%;
    min-height: 4.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-tabs li {
    display: flex;
  }

  .primary-tabs a {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--shell-navigation-text);
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    font-weight: 650;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .primary-tabs a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 0.25rem;
    border-radius: 0.25rem 0.25rem 0 0;
    background: var(--primary);
    content: '';
    scale: 0 1;
    transition: scale var(--duration-fast) ease;
  }

  .primary-tabs a:hover,
  .primary-tabs a[aria-current='page'] {
    color: var(--shell-navigation-active);
  }

  .primary-tabs a:hover::after,
  .primary-tabs a[aria-current='page']::after {
    scale: 1 1;
  }

  @media (max-width: 47.99rem) {
    .app-banner__hero {
      min-height: 17rem;
    }

    .app-banner__description {
      max-width: 34rem;
    }

    .primary-tabs,
    .primary-tabs ul {
      min-height: 4rem;
    }
  }

  @media (max-width: 35.99rem) {
    .app-banner {
      border-radius: 1.2rem;
    }

    .app-banner__hero {
      min-height: 18rem;
      padding: 1.65rem 1.5rem;
    }

    .app-banner__eyebrow {
      max-width: 18rem;
      line-height: 1.45;
    }

    .app-banner__title {
      margin-top: 1.65rem;
      font-size: clamp(2.8rem, 15vw, 4.25rem);
    }

    .app-banner__description {
      font-size: 1rem;
      line-height: 1.6;
    }

    .primary-tabs {
      padding-inline: 1.25rem;
    }

    .primary-tabs ul {
      gap: 1.5rem;
    }

    .primary-tabs a {
      font-size: 0.9rem;
    }
  }
</style>
