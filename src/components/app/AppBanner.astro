---
import type { Locale } from '@/i18n/config';
import { sharedMessages } from '@/i18n/messages';
import {
  isCurrentRoute,
  localizedRoute,
  type LocalizedRouteKey,
} from '@/lib/routes';
import { Skeleton } from '@/components/ui/skeleton';
import {
  BookOpenText,
  Compass,
  GitCompareArrows,
  LibraryBig,
} from 'lucide-react';

interface Props {
  compact?: boolean;
  currentPath: string;
  locale: Locale;
  phoneSecondaryRoute?: LocalizedRouteKey;
}

const {
  compact = false,
  currentPath,
  locale,
  phoneSecondaryRoute,
} = Astro.props;
const messages = sharedMessages[locale];
const navigation = [
  {
    key: 'catalogue',
    label: messages.navigation.catalogue,
    icon: LibraryBig,
  },
  {
    key: 'consultation',
    label: messages.navigation.guide,
    icon: Compass,
  },
  {
    key: 'compare',
    label: messages.navigation.compare,
    icon: GitCompareArrows,
  },
  {
    key: 'runningBasics',
    label: messages.navigation.runningBasics,
    icon: BookOpenText,
  },
] as const;
const navigationLinks = navigation.map((item) => ({
  ...item,
  href: localizedRoute(locale, item.key),
}));
---

<header
  class:list={['app-banner page-container', { 'app-banner--compact': compact }]}
  data-phone-secondary-route={phoneSecondaryRoute}
>
  <div class="app-banner__hero">
    <a
      class="app-banner__brand"
      href={localizedRoute(locale, 'catalogue')}
      aria-label={messages.banner.catalogueLabel}
    >
      <span class="app-banner__eyebrow">{messages.banner.eyebrow}</span>
      <span class="app-banner__title">RunDecoded</span>
      <span class="app-banner__rail-mark" aria-hidden="true">
        <span>R</span><span>D</span>
      </span>
    </a>
    <p class="app-banner__description">
      {messages.banner.description}
    </p>
    <span class="app-banner__watermark" aria-hidden="true">RUN</span>
  </div>

  {
    !compact && (
      <nav
        class="primary-tabs max-[35.99rem]:p-0!"
        aria-label="Primary navigation"
      >
        <ul class="max-[35.99rem]:gap-0!">
          {navigationLinks.map(({ icon: Icon, ...item }) => (
            <li class="max-[35.99rem]:min-w-0 max-[35.99rem]:flex-1">
              <a
                class="max-[35.99rem]:min-h-[calc(4.25rem+env(safe-area-inset-bottom))] max-[35.99rem]:w-full max-[35.99rem]:flex-1 max-[35.99rem]:rounded-none max-[35.99rem]:pb-[env(safe-area-inset-bottom)]"
                aria-current={
                  isCurrentRoute(currentPath, item.key) ? 'page' : undefined
                }
                data-navigation-key={item.key}
                data-route-current={
                  isCurrentRoute(currentPath, item.key) ? 'true' : undefined
                }
                data-astro-prefetch="load"
                href={item.href}
              >
                <Icon className="primary-tabs__icon" aria-hidden="true" />
                <span>{item.label}</span>
                <Skeleton
                  aria-hidden="true"
                  className="primary-tabs__pending-skeleton"
                  data-navigation-skeleton
                />
                {item.key === 'compare' && (
                  <span
                    aria-hidden="true"
                    class="primary-tabs__comparison-count"
                    data-comparison-count
                    hidden
                  >
                    0
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<script>
  const comparisonSelectionStorageKey =
    'rundecoded:catalogue-comparison-selection';
  const phoneBreakpoint = window.matchMedia('(max-width: 35.99rem)');

  function shoeReturnRoute(shoeId?: string) {
    try {
      const context = JSON.parse(
        window.sessionStorage.getItem('rundecoded:phone-shoe-return') ?? 'null',
      ) as { shoeId?: unknown; source?: unknown } | null;
      return context?.shoeId === shoeId && context?.source === 'consultation'
        ? 'consultation'
        : 'catalogue';
    } catch {
      return 'catalogue';
    }
  }

  function phoneSecondaryActiveRoute() {
    const secondaryRoute = document.querySelector<HTMLElement>(
      '[data-phone-secondary-route]',
    )?.dataset.phoneSecondaryRoute;
    if (secondaryRoute === 'catalogue') {
      const shoeId = decodeURIComponent(
        window.location.pathname.split('/').filter(Boolean).at(-1) ?? '',
      );
      return shoeReturnRoute(shoeId);
    }
    if (secondaryRoute !== 'settings') return null;

    const stored = window.sessionStorage.getItem(
      'rundecoded:phone-settings-return',
    );
    if (!stored) return null;
    const returnUrl = new URL(stored, window.location.origin);
    if (returnUrl.origin !== window.location.origin) return null;
    const [, section, shoeId] =
      returnUrl.pathname.match(
        /\/(?:en|de|fr)\/(catalogue|consultation|compare|running-basics)(?:\/([^/]+))?\/?$/,
      ) ?? [];
    if (section === 'catalogue')
      return shoeId ? shoeReturnRoute(decodeURIComponent(shoeId)) : section;
    return section === 'running-basics' ? 'runningBasics' : (section ?? null);
  }

  function syncPhoneActiveNavigation() {
    const activeRoute = phoneBreakpoint.matches
      ? phoneSecondaryActiveRoute()
      : null;
    document
      .querySelectorAll<HTMLAnchorElement>('[data-navigation-key]')
      .forEach((link) => {
        const active = activeRoute
          ? link.dataset.navigationKey === activeRoute
          : link.dataset.routeCurrent === 'true';
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
  }

  function storedComparisonCount() {
    try {
      const selection = JSON.parse(
        window.sessionStorage.getItem(comparisonSelectionStorageKey) ?? '[]',
      );
      return Array.isArray(selection)
        ? selection.filter((id) => typeof id === 'string').length
        : 0;
    } catch {
      return 0;
    }
  }

  function syncComparisonCount(event?: Event) {
    const detail =
      event instanceof CustomEvent
        ? (event.detail as { count?: unknown } | undefined)
        : undefined;
    const count =
      typeof detail?.count === 'number'
        ? Math.max(0, detail.count)
        : storedComparisonCount();

    document
      .querySelectorAll<HTMLElement>('[data-comparison-count]')
      .forEach((badge) => {
        badge.textContent = String(count);
        badge.hidden = count === 0;
      });
  }

  function showPendingNavigation(event: Event) {
    const source = (event as Event & { sourceElement?: Element }).sourceElement;
    const link = source?.closest<HTMLAnchorElement>('[data-navigation-key]');
    if (!link) return;

    document
      .querySelectorAll<HTMLAnchorElement>('[data-navigation-key]')
      .forEach((navigationLink) => {
        if (navigationLink === link) {
          navigationLink.setAttribute('aria-current', 'page');
          navigationLink.setAttribute('aria-busy', 'true');
          navigationLink.dataset.navigationPending = 'true';
        } else {
          navigationLink.removeAttribute('aria-current');
          navigationLink.removeAttribute('aria-busy');
          delete navigationLink.dataset.navigationPending;
        }
      });
  }

  syncComparisonCount();
  syncPhoneActiveNavigation();
  phoneBreakpoint.addEventListener('change', syncPhoneActiveNavigation);
  document.addEventListener('astro:before-preparation', showPendingNavigation);
  window.addEventListener(
    'rundecoded:comparison-selection-change',
    syncComparisonCount,
  );
  document.addEventListener('astro:page-load', () => {
    syncComparisonCount();
    syncPhoneActiveNavigation();
  });
</script>

<style>
  .app-banner {
    margin-top: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--shell-navigation-border);
    border-radius: var(--radius-shell);
    background: var(--shell-navigation);
    box-shadow: var(--shadow-panel);
  }

  .app-banner__hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(15rem, 30vw, 21rem);
    overflow: hidden;
    background: linear-gradient(
      120deg,
      var(--banner-start),
      var(--banner-middle) 58%,
      var(--banner-end)
    );
    color: var(--banner-foreground);
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .app-banner__hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 82% 10%,
        rgb(255 255 255 / 12%),
        transparent 28%
      ),
      linear-gradient(90deg, rgb(255 255 255 / 4%), transparent 45%);
    content: '';
  }

  .app-banner__brand {
    display: inline-flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .app-banner__eyebrow {
    color: var(--banner-muted);
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    font-weight: 750;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .app-banner__title {
    margin-top: clamp(1.2rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 780;
    letter-spacing: -0.075em;
    line-height: 0.86;
  }

  .app-banner__rail-mark,
  .primary-tabs__icon,
  .primary-tabs__comparison-count {
    display: none;
  }

  .app-banner__description {
    position: relative;
    z-index: 1;
    max-width: 49rem;
    margin: clamp(1.3rem, 3vw, 2rem) 0 0;
    color: var(--banner-foreground);
    font-size: clamp(1rem, 2.1vw, 1.35rem);
    line-height: 1.55;
  }

  .app-banner__watermark {
    position: absolute;
    right: -0.02em;
    bottom: -0.28em;
    z-index: 0;
    color: rgb(255 255 255 / 10%);
    font-size: clamp(9rem, 25vw, 20rem);
    font-weight: 850;
    letter-spacing: -0.1em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .app-banner--compact .app-banner__hero {
    display: grid;
    grid-template-columns: minmax(12rem, auto) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    min-height: 0;
    padding: 1.25rem clamp(1.5rem, 4vw, 2.5rem);
  }

  .app-banner--compact .app-banner__title {
    margin-top: 0.3rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 0.95;
  }

  .app-banner--compact .app-banner__description {
    max-width: 43rem;
    margin: 0;
    font-size: clamp(0.9rem, 1.7vw, 1.05rem);
  }

  .app-banner--compact .app-banner__watermark {
    bottom: -0.5em;
    font-size: clamp(6rem, 15vw, 10rem);
  }

  .primary-tabs {
    min-height: 4.5rem;
    padding-inline: clamp(1rem, 3vw, 2.25rem);
  }

  .primary-tabs ul {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 4vw, 2.5rem);
    height: 100%;
    min-height: 4.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-tabs li {
    display: flex;
  }

  .primary-tabs a {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--shell-navigation-text);
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    font-weight: 650;
    text-decoration: none;
  }

  .primary-tabs__pending-skeleton {
    position: absolute;
    bottom: 0.65rem;
    left: 50%;
    display: none;
    width: 2.5rem;
    height: 0.22rem;
    translate: -50% 0;
  }

  .primary-tabs
    a[data-navigation-pending='true']
    .primary-tabs__pending-skeleton {
    display: block;
  }

  .primary-tabs a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 0.25rem;
    border-radius: 0.25rem 0.25rem 0 0;
    background: var(--primary);
    content: '';
    scale: 0 1;
  }

  .primary-tabs a:hover,
  .primary-tabs a[aria-current='page'] {
    color: var(--shell-navigation-active);
  }

  .primary-tabs a:hover::after,
  .primary-tabs a[aria-current='page']::after {
    scale: 1 1;
  }

  /* Tablet navigation uses one compact rail in portrait and landscape. */
  @media (min-width: 36rem) and (max-width: 64rem) {
    .app-banner {
      display: flex;
      position: sticky;
      top: 0;
      z-index: 20;
      flex-direction: column;
      align-self: start;
      width: 5.5rem;
      height: 100vh;
      height: 100dvh;
      min-height: 100vh;
      margin: 0;
      overflow-y: auto;
      border-width: 0 1px 0 0;
      border-color: color-mix(in srgb, var(--border) 55%, transparent);
      border-radius: 0;
      box-shadow: none;
      background: var(--surface);
    }

    .app-banner__hero {
      display: flex;
      min-height: 5.5rem;
      align-items: center;
      justify-content: center;
      padding: 0.75rem;
      background: var(--surface);
    }

    .app-banner__hero::before {
      display: none;
    }

    .app-banner__brand {
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .app-banner__eyebrow,
    .app-banner__description,
    .app-banner__watermark {
      display: none;
    }

    .app-banner__title {
      display: none;
    }

    .app-banner__rail-mark {
      display: flex;
      color: var(--foreground);
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.08em;
      line-height: 1;
    }

    .app-banner__rail-mark span:last-child {
      color: var(--primary);
    }

    .primary-tabs,
    .primary-tabs ul {
      min-height: 0;
    }

    .primary-tabs {
      flex: 1;
      padding: 0.75rem 0.4rem;
    }

    .primary-tabs ul {
      flex-direction: column;
      gap: 0.35rem;
    }

    .primary-tabs li,
    .primary-tabs a {
      width: 100%;
    }

    .primary-tabs a {
      flex-direction: column;
      gap: 0.35rem;
      min-height: 3.75rem;
      justify-content: center;
      padding: 0.5rem 0.25rem;
      border-radius: var(--radius-control);
      font-size: 0.68rem;
      line-height: 1.2;
      text-align: center;
      color: var(--muted-foreground);
    }

    .primary-tabs__icon {
      display: block;
      width: 1.15rem;
      height: 1.15rem;
      flex: none;
      stroke-width: 1.9;
    }

    .primary-tabs__comparison-count {
      position: absolute;
      top: 0.25rem;
      right: 0.3rem;
      z-index: 1;
      display: inline-flex;
      min-width: 1.25rem;
      height: 1.25rem;
      align-items: center;
      justify-content: center;
      padding-inline: 0.25rem;
      border-radius: 999px;
      background: var(--primary);
      box-shadow: 0 0 0 2px var(--surface);
      color: var(--primary-foreground);
      font-size: 0.65rem;
      font-weight: 800;
      line-height: 1;
    }

    .primary-tabs__comparison-count[hidden] {
      display: none;
    }

    .primary-tabs__pending-skeleton {
      bottom: 0.3rem;
      width: 1.75rem;
      height: 0.18rem;
    }

    .primary-tabs a::after {
      right: 0;
      bottom: 0;
      left: 0;
      height: 100%;
      border-radius: var(--radius-control);
      background: var(--primary);
      opacity: 0.16;
      scale: 0;
      z-index: -1;
    }

    .primary-tabs a:hover::after,
    .primary-tabs a[aria-current='page']::after {
      scale: 1;
    }

    .primary-tabs a:hover,
    .primary-tabs a[aria-current='page'] {
      color: var(--primary);
    }
  }

  @media (max-width: 35.99rem) {
    .app-banner {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      width: 100%;
      margin: 0;
      overflow: visible;
      border-width: 1px 0 0;
      border-color: var(--border);
      border-radius: 0;
      background: var(--surface);
      box-shadow: 0 -4px 20px rgb(10 22 40 / 8%);
    }

    .app-banner__hero {
      display: none;
    }

    .primary-tabs {
      min-height: 0;
    }

    .primary-tabs ul {
      min-height: 0;
    }

    .primary-tabs a {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.2rem;
      color: var(--muted-foreground);
      font-size: 0.68rem;
      line-height: 1.2;
      text-align: center;
    }

    .primary-tabs__icon {
      display: block;
      width: 1.15rem;
      height: 1.15rem;
    }

    .primary-tabs a::after {
      inset: 0;
      height: auto;
      border-radius: 0;
      opacity: 0.12;
      z-index: -1;
    }

    .primary-tabs a:hover,
    .primary-tabs a[aria-current='page'] {
      color: var(--primary);
    }

    .primary-tabs__comparison-count {
      position: absolute;
      top: 0.1rem;
      right: 0.5rem;
      display: inline-flex;
      min-width: 1.2rem;
      height: 1.2rem;
      align-items: center;
      justify-content: center;
      padding-inline: 0.2rem;
      border-radius: 999px;
      background: var(--primary);
      color: var(--primary-foreground);
      font-size: 0.62rem;
      font-weight: 800;
    }

    .primary-tabs__comparison-count[hidden] {
      display: none;
    }
  }
</style>
