---
import { routes } from '@/lib/routes';

import { DisplayControls } from '../DisplayControls';

interface Props {
  locale: 'de' | 'en' | 'fr';
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer page-container">
  <div class="site-footer__controls">
    <DisplayControls client:only="react" initialLocale={locale} />
  </div>
  <p class="site-footer__credit">
    <span class="site-footer__credit-full">
      © {year} Running Product Training · By Jerika
    </span>
    <span class="site-footer__credit-compact">© {year} · By Jerika</span>
  </p>
  <a
    class="site-footer__preview"
    data-locale-aware
    href={`${routes.designSystem}?lang=${locale}`}
  >
    System preview
  </a>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    margin-top: auto;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
  }

  .site-footer__controls {
    justify-self: start;
  }

  .site-footer__credit {
    margin: 0;
    font-size: 0.8rem;
    text-align: center;
  }

  .site-footer__credit-compact {
    display: none;
  }

  .site-footer__preview {
    justify-self: end;
    font-size: 0.75rem;
    text-decoration: none;
    text-underline-offset: 0.25rem;
  }

  .site-footer__preview:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  @media (max-width: 47.99rem) {
    .site-footer {
      grid-template-columns: auto 1fr;
      min-height: 4.5rem;
    }

    .site-footer__credit {
      justify-self: end;
      text-align: right;
    }

    .site-footer__credit-full,
    .site-footer__preview {
      display: none;
    }

    .site-footer__credit-compact {
      display: inline;
    }
  }
</style>
